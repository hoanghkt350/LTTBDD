rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function lineTotal(items, index) {
      return index < items.size() ? items[items.keys()[index]].price * items[items.keys()[index]].quantity : 0;
    }
    function checkedLine(items, id, orderId, cancelling) {
      let line = items[id];
      let before = get(/databases/$(database)/documents/products/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/products/$(id)).data;
      return line.keys().hasOnly(['name','price','quantity','imageUrl'])
        && line.quantity is int && line.quantity >= 1 && line.quantity <= 99
        && (cancelling || (before.get('isActive', true) == true && line.price == before.price && line.name == before.name && line.imageUrl == before.imageUrl))
        && after.stock == before.stock + (cancelling ? line.quantity : -line.quantity)
        && after.stock >= 0 && after.lastOrderId == orderId && after.updatedAt == request.time;
    }
    function allStockLines(items, orderId, cancelling) {
      let keys = items.keys();
      return items is map && items.size() >= 1 && items.size() <= 5
        && checkedLine(items,keys[0],orderId,cancelling)
        && (keys.size() < 2 || checkedLine(items,keys[1],orderId,cancelling))
        && (keys.size() < 3 || checkedLine(items,keys[2],orderId,cancelling))
        && (keys.size() < 4 || checkedLine(items,keys[3],orderId,cancelling))
        && (keys.size() < 5 || checkedLine(items,keys[4],orderId,cancelling));
    }
    function validOrder(orderId) {
      let o = request.resource.data;
      let sum = lineTotal(o.items,0) + lineTotal(o.items,1) + lineTotal(o.items,2)
        + lineTotal(o.items,3) + lineTotal(o.items,4);
      let discount = o.voucher in ['PAWPALS10','HUTECH10'] ? math.round(sum * 0.1) : 0;
      let shipping = sum >= 300000 || o.voucher == 'FREESHIP' ? 0 : 25000;
      return o.keys().hasOnly(['orderId','userId','items','recipient','subtotal','discountAmount','shippingFee','totalAmount','voucher','status','paymentMethod','createdAt'])
        && o.orderId == orderId && o.userId == request.auth.uid
        && o.status == 'Chờ xác nhận' && o.paymentMethod == 'COD' && o.createdAt == request.time
        && o.voucher in ['','PAWPALS10','HUTECH10','FREESHIP']
        && o.recipient.keys().hasOnly(['name','phone','address'])
        && o.recipient.name is string && o.recipient.name.size() > 0 && o.recipient.name.size() <= 80
        && o.recipient.phone is string && o.recipient.phone.matches('^[+]?[0-9]{9,12}$')
        && o.recipient.address is string && o.recipient.address.size() >= 8 && o.recipient.address.size() <= 300
        && o.subtotal == sum && o.discountAmount == discount && o.shippingFee == shipping
        && o.totalAmount == sum - discount + shipping
        && allStockLines(o.items,orderId,false);
    }
    match /orders/{orderId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && validOrder(orderId);
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin())
        && resource.data.status == 'Chờ xác nhận' && request.resource.data.status == 'Đã hủy'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt'])
        && request.resource.data.cancelledAt == request.time
        && allStockLines(resource.data.items,orderId,true);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusUpdatedAt','statusUpdatedBy'])
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && ((resource.data.status == 'Chờ xác nhận' && request.resource.data.status == 'Đang giao')
          || (resource.data.status == 'Đang giao' && request.resource.data.status == 'Hoàn thành'));
      allow delete: if false;
    }
    match /products/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() && validProduct(id);
      // Products are archived so historical orders can still return their stock.
      allow delete: if false;
      // Only reserve or return stock as part of the same atomic order transaction.
      allow update: if signedIn()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','lastOrderId','updatedAt'])
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.updatedAt == request.time
        && validProductStock(id))
        || (request.auth.token.get('admin', false) == true && validProduct(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id','name','category','petTarget','price','originalPrice','discountPercent','stock','rating','reviewCount','imageUrl','description','weight','isFeatured','isActive','updatedAt'])));
      function validProductStock(productId) {
        let orderId = request.resource.data.lastOrderId;
        let orderPath = /databases/$(database)/documents/orders/$(orderId);
        let after = getAfter(orderPath).data;
        return (after.userId == request.auth.uid || isAdmin())
          && productId in after.items
          && ((!exists(orderPath) && after.status == 'Chờ xác nhận' && after.createdAt == request.time
            && request.resource.data.stock == resource.data.stock - after.items[productId].quantity)
          || (exists(orderPath) && get(orderPath).data.status == 'Chờ xác nhận'
            && after.status == 'Đã hủy' && after.cancelledAt == request.time
            && request.resource.data.stock == resource.data.stock + after.items[productId].quantity));
      }
      function validProduct(productId) {
        let p = request.resource.data;
        return p.keys().hasOnly(['id','name','category','petTarget','price','originalPrice','discountPercent','stock','rating','reviewCount','imageUrl','description','weight','isFeatured','isActive','updatedAt','lastOrderId'])
          && p.id == productId && p.name is string && p.name.size() > 0 && p.name.size() <= 120
          && p.category in ['FOOD','ACCESSORY','TOY','HEALTH','HYGIENE'] && p.petTarget in ['DOG','CAT','ALL']
          && p.price is number && p.price > 0 && p.price <= 1000000000
          && p.originalPrice is number && p.originalPrice >= p.price && p.originalPrice <= 1000000000
          && p.stock is int && p.stock >= 0 && p.stock <= 1000000
          && p.description is string && p.description.size() <= 10000
          && validImage(p.imageUrl) && p.get('isActive', true) is bool && p.isFeatured is bool
          && p.updatedAt == request.time;
      }
    }
    function validImage(value) {
      return value is string && value.size() <= 2000 && (value == '' || value.matches('^https://[^ ]+$'));
    }
    match /clinics/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id','name','address','latitude','longitude','phone','rating','isOpen24_7','openHours','services','distanceKm','updatedAt'])
        && request.resource.data.id == id
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 300
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.phone.matches('^[+]?[0-9]{9,12}$')
        && request.resource.data.isOpen24_7 is bool
        && request.resource.data.openHours is string && request.resource.data.openHours.size() <= 120
        && request.resource.data.services is list && request.resource.data.services.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }
    match /articles/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id','title','category','author','publishedAt','thumbnailUrl','summary','content','readTimeMinutes','updatedAt'])
        && request.resource.data.id == id
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 80
        && request.resource.data.author is string && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 80
        && request.resource.data.publishedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validImage(request.resource.data.thumbnailUrl)
        && request.resource.data.summary is string && request.resource.data.summary.size() > 0 && request.resource.data.summary.size() <= 1000
        && request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 50000
        && request.resource.data.readTimeMinutes is int && request.resource.data.readTimeMinutes > 0 && request.resource.data.readTimeMinutes <= 120
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid','email','displayName','phoneNumber','address','avatarUrl','membershipLevel'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80
        && request.resource.data.membershipLevel == 'STANDARD';
      match /{collection}/{id} {
        allow read: if owns(uid) && collection in ['pets','health_records','reminders'];
        allow create, update: if owns(uid) && collection in ['pets','health_records','reminders']
          && request.resource.data.id is int && string(request.resource.data.id) == id
          && request.resource.data.updatedAt == request.time
          && (validTombstone() || validEntity(collection));
        function validTombstone() {
          return request.resource.data.keys().hasOnly(['id','deleted','updatedAt']) && request.resource.data.deleted == true;
        }
        function validEntity(collection) {
          let d = request.resource.data;
          return !('deleted' in d) &&
            ((collection == 'pets' && d.name is string && d.name.size() > 0 && d.name.size() <= 80
              && d.weight is number && d.weight > 0 && d.weight <= 500
              && (d.avatar_cloud_url == null || (d.avatar_cloud_url is string && d.avatar_cloud_url.size() < 250000)))
            || (collection == 'health_records' && d.pet_id is int && d.title is string && d.title.size() <= 150
              && d.cost is number && d.cost >= 0)
            || (collection == 'reminders' && d.pet_id is int && d.title is string && d.title.size() > 0
              && d.title.size() <= 150 && d.reminder_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
              && d.is_active in [0,1] && d.repeat_interval == 'DAILY'));
        }
      }
    }
  }
}
